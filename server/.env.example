# iTorgo Backend Configuration
PORT=5000
NODE_ENV=production
# Generate with: openssl rand -hex 48 (min 32 chars, REQUIRED in production — server refuses to start without it)
JWT_SECRET=
JWT_EXPIRES_IN=7d
DB_PATH=database/auktsion.sqlite
UPLOAD_DIR=uploads
FRONTEND_DIST=../frontend/dist
# Comma-separated allow-list once admin.<domain> is live, e.g.:
# CORS_ORIGIN=https://itorgo.kg,https://admin.itorgo.kg
CORS_ORIGIN=*
# Set to "false" to skip demo seeding; in production seeding additionally requires SEED_DATABASE=true
SEED_DATABASE=
