# iTorgo Frontend Environment Variables
# Copy this file to .env.local and fill in the values

# App
VITE_APP_NAME="iTorgo"
VITE_APP_URL="http://localhost:5173"
# Admin panel is served by this SAME app/build, gated by hostname at runtime
# (see src/router/index.ts) — it is only reachable via this admin subdomain,
# never via /admin on the main domain. Local dev: http://admin.localhost:5173
# (auto-resolves in-browser, no hosts file edit needed). Production: point
# admin.itorgo.kg at the same server via a DNS record at your host/registrar.
VITE_ADMIN_URL="http://admin.localhost:5173"

# API
VITE_API_URL="http://localhost:8000/api"
VITE_API_TIMEOUT=30000

# Real-time (native WebSocket — see src/composables/useEcho.ts). Only needed
# if the WS endpoint lives on a different host than the API; otherwise it's
# derived automatically from the page origin.
# VITE_WS_URL="wss://itorgo.kg/ws"

# AI listing generator (9Router-compatible endpoint). Leave empty to use the
# built-in local fallback generator. NOTE: values are bundled into the client
# build — only ever put keys that are safe to expose publicly here.
VITE_AI_ROUTER_BASE_URL=""
VITE_AI_ROUTER_API_KEY=""
VITE_AI_ROUTER_MODEL=""

# Payment Gateways (Client-side keys only)
VITE_MBANK_CLIENT_ID=""
VITE_OPTIMA_CLIENT_ID=""
VITE_DEMIRBANK_CLIENT_ID=""
VITE_STRIPE_PUBLISHABLE_KEY=""

# Analytics
VITE_GA_MEASUREMENT_ID=""
VITE_YANDEX_METRIKA_ID=""

# Feature Flags
VITE_ENABLE_PWA=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_SENTRY=false

# Sentry (Error tracking)
VITE_SENTRY_DSN=""

# CDN
VITE_CDN_URL="https://cdn.itorgo.kg"

# Feature toggles
VITE_ENABLE_BETA_FEATURES=false