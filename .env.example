# Auktsion v2.0 — Production Environment Variables
# Copy to .env and fill in all values
# NEVER commit .env to version control!

# =============================================================================
# DOMAIN & SSL
# =============================================================================
DOMAIN=auktsion.kg
# SSL certificates should be placed in nginx/ssl/
# fullchain.pem, privkey.pem, chain.pem

# =============================================================================
# DATABASE (PostgreSQL Production)
# =============================================================================
DB_NAME=auktsion
DB_USER=auktsion
DB_PASSWORD=CHANGE_ME_SECURE_PASSWORD_32_CHARS_MIN

# =============================================================================
# AUTHENTICATION (JWT)
# =============================================================================
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_JWT_SECRET_32_CHARS_MINIMUM
REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_32_CHARS_MINIMUM

# =============================================================================
# REDIS
# =============================================================================
# No password by default (internal network only)
# REDIS_PASSWORD=optional_secure_password

# =============================================================================
# MEILISEARCH
# =============================================================================
MEILI_MASTER_KEY=CHANGE_ME_MEILI_MASTER_KEY

# =============================================================================
# ADMIN SEED (Optional - only for first deploy)
# =============================================================================
SEED_ADMIN=false

# =============================================================================
# EXTERNAL SERVICES (Future integrations)
# =============================================================================
# MBank
MBANK_CLIENT_ID=
MBANK_CLIENT_SECRET=
MBANK_WEBHOOK_SECRET=

# Optima Bank
OPTIMA_CLIENT_ID=
OPTIMA_CLIENT_SECRET=
OPTIMA_WEBHOOK_SECRET=

# DemirBank
DEMIR_CLIENT_ID=
DEMIR_CLIENT_SECRET=
DEMIR_API_KEY=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@auktsion.kg

# SMS (Megacom/Beeline/O!)
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

# Monitoring (Sentry, etc.)
SENTRY_DSN=